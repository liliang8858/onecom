# Enterprise Agent local configuration.
#
# Copy this file to .env for local experiments if your tooling supports it.
# The chapter 04 code reads real environment variables; it does not parse .env
# files directly.
ENTERPRISE_AGENT_APP_NAME=enterprise-agent
ENTERPRISE_AGENT_ENV=development
ENTERPRISE_AGENT_LOG_LEVEL=INFO
ENTERPRISE_AGENT_DEFAULT_MODEL=mock-chat
ENTERPRISE_AGENT_TOKEN_BUDGET=100000
